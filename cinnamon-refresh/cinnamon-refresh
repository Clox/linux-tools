#!/usr/bin/env bash
set -euo pipefail

MIN_RSS_KIB=1048576
MIN_IDLE_MILLISECONDS=3600000

read_idle() {
    local value
    command -v xssstate >/dev/null 2>&1 || return 1
    value=$(timeout 5 xssstate -i 2>/dev/null) || return 1
    [[ "$value" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "$value"
}

usage() {
    echo "Användning: cinnamon-refresh status | restart | auto" >&2
    exit 2
}

case "${1:-}" in
    status|restart|auto) action=$1 ;;
    *) usage ;;
esac
(( $# == 1 )) || usage

if [[ "${XDG_CURRENT_DESKTOP:-}" != *Cinnamon* || "${XDG_SESSION_TYPE:-}" != x11 || -z "${DISPLAY:-}" ]]; then
    echo "Kräver en aktiv Cinnamon-session med X11." >&2
    exit 1
fi

mapfile -t pids < <(pgrep -u "$(id -u)" -x cinnamon || true)
if (( ${#pids[@]} != 1 )); then
    echo "Förväntade en Cinnamon-process, hittade ${#pids[@]}." >&2
    exit 1
fi
pid=${pids[0]}
read -r age rss < <(ps -p "$pid" -o etimes=,rss=)

printf 'Cinnamon: PID %s, drifttid %s dagar, RSS %s MiB\n' \
    "$pid" "$((age / 86400))" "$((rss / 1024))"

if [[ "$action" == status ]]; then
    if idle=$(read_idle); then
        printf 'Inaktivitet: %s minuter\n' "$((idle / 60000))"
    else
        echo "Inaktivitet: kunde inte mätas"
    fi
    if [[ "${idle:-}" =~ ^[0-9]+$ ]] && \
       (( rss >= MIN_RSS_KIB && idle >= MIN_IDLE_MILLISECONDS )); then
        echo "Automatisk omstart skulle utlösas om ingen utskrift pågår."
    else
        echo "Automatisk omstart skulle inte utlösas."
    fi
    exit 0
fi

if [[ "$action" == auto ]] && (( rss < MIN_RSS_KIB )); then
    echo "Ingen omstart behövs."
    exit 0
fi

if [[ "$action" == auto ]]; then
    if ! idle=$(read_idle); then
        echo "Kan inte mäta inaktivitet; Cinnamon startas inte om." >&2
        exit 1
    fi
    if (( idle < MIN_IDLE_MILLISECONDS )); then
        printf 'Bara %s minuter inaktivitet; ingen omstart.\n' "$((idle / 60000))"
        exit 0
    fi
fi

# Starta aldrig om skalet mitt under ett utskriftsjobb.
if ! command -v lpstat >/dev/null 2>&1; then
    echo "Kan inte kontrollera utskriftskön: lpstat saknas." >&2
    exit 1
fi
if ! jobs=$(timeout 5 lpstat -o 2>/dev/null); then
    echo "Kan inte kontrollera utskriftskön; Cinnamon startas inte om." >&2
    exit 1
fi
if [[ -n "$jobs" ]]; then
    echo "Utskrift pågår; Cinnamon startas inte om."
    exit 0
fi

if ! command -v systemd-run >/dev/null 2>&1; then
    echo "systemd-run saknas." >&2
    exit 1
fi

# Kontrollera igen precis innan en automatisk omstart om användaren kommit tillbaka.
if [[ "$action" == auto ]]; then
    if ! idle=$(read_idle) || (( idle < MIN_IDLE_MILLISECONDS )); then
        echo "Användaren är aktiv igen, eller inaktivitet kan inte mätas; ingen omstart."
        exit 0
    fi
fi

unit="cinnamon-refresh-$(date +%s)-$$"
echo "Startar om Cinnamon via användarens systemd-session..."
systemd-run --user --collect --unit="$unit" /usr/bin/cinnamon --replace

for ((i = 0; i < 20; i++)); do
    sleep 1
    mapfile -t new_pids < <(pgrep -u "$(id -u)" -x cinnamon || true)
    for new_pid in "${new_pids[@]}"; do
        if [[ "$new_pid" != "$pid" ]] && kill -0 "$new_pid" 2>/dev/null; then
            new_rss=$(ps -p "$new_pid" -o rss= | tr -d ' ')
            printf 'Cinnamon omstartad: PID %s, RSS %s MiB\n' "$new_pid" "$((new_rss / 1024))"
            exit 0
        fi
    done
done

echo "Kunde inte verifiera en ny Cinnamon-process inom 20 sekunder. Kontrollera sessionen." >&2
exit 1
